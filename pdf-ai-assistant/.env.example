# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Set to false if the provider rejects the "reasoning disabled" switch
LLM_DISABLE_REASONING=true
# Optional: EMBED_MODEL=intfloat/multilingual-e5-small  (smaller, faster, less accurate)
# Optional: DATA_DIR=./data  MAX_UPLOAD_MB=25  MAX_PAGES=300  DOC_TTL_HOURS=0 (0 keeps documents indefinitely)
